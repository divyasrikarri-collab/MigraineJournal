# Copy to keystore.properties (gitignored) and fill in with your own upload key.
#
# Create the key first:
#   keytool -genkeypair -v -keystore ~/keys/migrainejournal-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Back up the .jks and these passwords somewhere durable. Without them you cannot
# publish an update to an existing Play listing without going through Google's
# upload-key reset process.

storeFile=/absolute/path/to/migrainejournal-upload.jks
storePassword=
keyAlias=upload
keyPassword=
